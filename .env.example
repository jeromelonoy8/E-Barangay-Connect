# Copy to .env and fill in. Never commit .env.

# --- Database (MySQL 8 / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=e_barangay_db
# Hosted databases such as Aiven need TLS:
# DB_SSL=true
# Set to true only if the provider's CA certificate is trusted by Node:
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- Server ---
PORT=5000
# NODE_ENV=production
# Comma-separated origins allowed to call the API from a browser (default: any)
# CORS_ORIGIN=https://your-frontend.example.com
# Behind Render or another proxy, set to 1 so rate limiting sees real client IPs
# TRUST_PROXY=1
# Set to false to skip running migrations on startup
# AUTO_MIGRATE=true

# --- Auth ---
# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Login/registration attempts allowed per IP every 15 minutes
# AUTH_RATE_LIMIT=20

# --- SMS (Semaphore) ---
# Leave blank to disable sending; messages are then logged as "Skipped".
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Time zone used for "today" when booking appointments
# APP_TIMEZONE=Asia/Manila

# Time slots, slot capacity, office days, announcement categories and official positions
# are not set here: the admin manages them in the database through PUT /api/settings.
